        "responsibility": "Provide backend-time distributed leases, managed renewal, monotonically increasing fencing tokens, and explicit worker and service coordination over memory, PostgreSQL, and Valkey backends.",
        "non_goals": [
          "Make unfenced work safe after lease loss, own business scheduling, hide ambiguous backend outcomes, or replace application transactions.",
          "Own caller-supplied PostgreSQL or Valkey clients, process-global lifecycle, or resource-side fence enforcement."
        ],
        "public_package_identifier": "lease",
        "primary_entry_packages": [
          "github.com/faustbrian/go-lease"
        ],
        "package_selection": {
          "github.com/faustbrian/go-lease": "Use for the backend-neutral fenced lease model, bounded acquisition, renewal, validation, release, and observation contracts.",
          "github.com/faustbrian/go-lease/leasequeue": "Use to add fenced unique-job and non-overlap admission to a caller-owned queue worker.",
          "github.com/faustbrian/go-lease/leasescheduler": "Use to run scheduled callbacks on one server or without overlap under distributed fenced ownership.",
          "github.com/faustbrian/go-lease/leaseservice": "Use to bound managed renewal and explicit release within caller-owned service lifecycle hooks.",
          "github.com/faustbrian/go-lease/leasetest": "Use in tests for a deterministic clock and reusable backend fencing conformance.",
          "github.com/faustbrian/go-lease/memory": "Use for deterministic process-local testing where replacement or restart may reset fencing history.",
          "github.com/faustbrian/go-lease/postgres": "Use for durable PostgreSQL leases and monotonically retained fence history with caller-owned pool lifecycle.",
          "github.com/faustbrian/go-lease/valkey": "Use for atomic Valkey leases and protected-write guards with caller-owned client lifecycle."
